// Bus Booking Web App (Pakistan) — Prisma schema
// PostgreSQL (Supabase) + Next.js App Router / TypeScript

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  PASSENGER
  OPERATOR
  CONDUCTOR
  ADMIN
  MASTER
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  role         UserRole @default(PASSENGER)
  /// Mr | Mrs | Ms | Miss
  title        String?
  firstName    String?
  lastName     String?
  dateOfBirth  DateTime?
  country      String?
  state        String?
  city         String?
  passportNumber String?
  nicNumber      String?
  /// Who created this staff/partner account (master → admin, admin → partner)
  createdById  String?
  createdAt    DateTime @default(now())

  createdBy     User?   @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers  User[]  @relation("UserCreatedBy")
  operatedBuses Bus[]      @relation("BusOperator")
  seatLocks     SeatLock[]
  bookings      Booking[]
  wallet        Wallet?
  rewards       RewardsAccount?

  @@index([role])
  @@index([createdById])
  @@map("users")
}

model Bus {
  id         String   @id @default(cuid())
  operatorId String
  busNumber  String   @unique // e.g. "FL-2026-VIP", "DAEWOO-786"
  layoutType String // "2x2", "2x1_SLEEPER"
  totalSeats Int
  createdAt  DateTime @default(now())

  operator User   @relation("BusOperator", fields: [operatorId], references: [id], onDelete: Restrict)
  trips    Trip[]

  @@index([operatorId])
  @@map("buses")
}

model Route {
  id              String @id @default(cuid())
  name            String
  originCity      String
  destinationCity String
  distanceKm      Float

  stops RouteStop[]
  trips Trip[]

  @@index([originCity, destinationCity])
  @@map("routes")
}

model RouteStop {
  id                 String @id @default(cuid())
  routeId            String
  stationName        String
  stopOrder          Int // 1, 2, 3...
  distanceFromOrigin Float // km from origin terminal

  route           Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  boardingTickets Ticket[] @relation("TicketBoardingStop")
  droppingTickets Ticket[] @relation("TicketDropStop")

  @@unique([routeId, stopOrder])
  @@index([routeId])
  @@map("route_stops")
}

model Trip {
  id            String   @id @default(cuid())
  busId         String
  routeId       String
  departureTime DateTime
  arrivalTime   DateTime
  basePrice     Decimal // PKR

  bus       Bus        @relation(fields: [busId], references: [id], onDelete: Restrict)
  route     Route      @relation(fields: [routeId], references: [id], onDelete: Restrict)
  seatLocks SeatLock[]
  bookings  Booking[]

  @@index([busId])
  @@index([routeId])
  @@index([departureTime])
  @@map("trips")
}

/// Temporary soft-hold while a passenger completes payment.
model SeatLock {
  id         String   @id @default(cuid())
  tripId     String
  seatNumber String
  userId     String
  lockToken  String   @unique
  expiresAt  DateTime

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, seatNumber])
  @@index([tripId, seatNumber])
  @@index([expiresAt])
  @@index([userId])
  @@map("seat_locks")
}

model Booking {
  id             String        @id @default(cuid())
  pnr            String        @unique // e.g. "PKR-8921A"
  userId         String
  tripId         String
  totalPrice     Decimal // PKR
  paymentStatus  PaymentStatus @default(PENDING)
  paymentMethod  String? // JAZZCASH | EASYPAISA | CARD
  qrCodeUrl      String?
  contactPhone   String?
  contactEmail   String?
  /// Comma-separated seat numbers held during PENDING checkout
  heldSeats      String?
  boardingStopId String?
  dropStopId     String?
  lockExpiresAt  DateTime?
  createdAt      DateTime      @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  trip    Trip     @relation(fields: [tripId], references: [id], onDelete: Restrict)
  tickets Ticket[]

  @@index([pnr])
  @@index([userId])
  @@index([tripId])
  @@index([paymentStatus])
  @@map("bookings")
}

model Ticket {
  id              String    @id @default(cuid())
  bookingId       String
  seatNumber      String
  passengerName   String
  passengerGender Gender
  passengerCnic   String?
  boardingStopId  String
  dropStopId      String
  isBoarded       Boolean   @default(false)
  boardedAt       DateTime?

  booking      Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  boardingStop RouteStop @relation("TicketBoardingStop", fields: [boardingStopId], references: [id], onDelete: Restrict)
  dropStop     RouteStop @relation("TicketDropStop", fields: [dropStopId], references: [id], onDelete: Restrict)

  @@unique([bookingId, seatNumber])
  @@index([bookingId])
  @@index([boardingStopId])
  @@index([dropStopId])
  @@index([isBoarded])
  @@map("tickets")
}

/// Bus operator / partner onboarding applications
model PartnerApplication {
  id            String   @id @default(cuid())
  companyName   String
  contactName   String
  email         String
  phone         String
  city          String
  fleetSize     Int
  routesServed  String
  message       String?
  status        String   @default("PENDING") // PENDING | REVIEWING | APPROVED | REJECTED
  createdAt     DateTime @default(now())

  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@map("partner_applications")
}

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Decimal  @default(0)
  currency  String   @default("PKR")
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id          String   @id @default(cuid())
  walletId    String
  /// TOPUP | WITHDRAW | REFUND | ADJUSTMENT
  type        String
  /// COMPLETED | PENDING | PROCESSING | FAILED | CANCELLED
  status      String   @default("COMPLETED")
  amount      Decimal
  description String
  reference   String   @unique
  bankName    String?
  iban        String?
  holderName  String?
  createdAt   DateTime @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@index([type, status])
  @@map("wallet_transactions")
}

model RewardsAccount {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Decimal  @default(0)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions RewardTransaction[]

  @@map("rewards_accounts")
}

model RewardTransaction {
  id          String    @id @default(cuid())
  accountId   String
  /// EARN | REDEEM | EXPIRE | CANCEL
  type        String
  /// PENDING | REWARDED | USED | EXPIRED | CANCELLED
  status      String
  amount      Decimal
  title       String
  orderId     String?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  account RewardsAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
  @@index([status])
  @@map("reward_transactions")
}
