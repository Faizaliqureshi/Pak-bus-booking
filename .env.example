# SQLite for local development (file is created under prisma/)
DATABASE_URL="file:./dev.db"

# Upstash Redis (TLS) — replace password + host from the Upstash dashboard
REDIS_URL="rediss://default:your_upstash_password@your_upstash_host:6379"

# Upstash serverless Redis (REST) — used by POST /api/booking/lock-seat
UPSTASH_REDIS_REST_URL="https://your-upstash-endpoint.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_rest_token"

# HMAC secret for signed e-ticket QR payloads
TICKET_QR_SECRET="safarpk-dev-ticket-secret-change-me"

# HS256 secret for HttpOnly access JWTs (RBAC on /api/admin/*)
JWT_SECRET="ticketpass-dev-jwt-secret-change-me"

# HMAC-SHA256 secret for POST /api/webhooks/payment-callback
PAYMENT_WEBHOOK_SECRET="ticketpass-dev-payment-webhook-secret-change-me"

# Public app URL used in ticket notification links
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Twilio Credentials (for WhatsApp & Global SMS)
TWILIO_ACCOUNT_SID="AC_YOUR_TWILIO_ACCOUNT_SID"
TWILIO_AUTH_TOKEN="YOUR_TWILIO_AUTH_TOKEN"
TWILIO_SMS_NUMBER="+1234567890"               # Your Twilio phone number
TWILIO_WHATSAPP_NUMBER="whatsapp:+14155238886" # Twilio WhatsApp sandbox/business number

# Local Pakistani SMS Gateway Credentials (Example: VeeVo / BrandSMS API)
LOCAL_SMS_API_KEY="YOUR_LOCAL_SMS_API_KEY"
LOCAL_SMS_SENDER_ID="DAEWOO_EXP"             # Mask/Sender ID approved by PTA
